# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo servidor: se usa para crear/eliminar usuarios desde la consola de administración. NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública del sistema (para los enlaces de restablecer contraseña). Ej: https://crm.akarautomotores.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido para el webhook de mensajes entrantes (/api/webhooks/mensajes)
WEBHOOK_SECRET=cambiar-por-un-valor-largo-y-aleatorio
