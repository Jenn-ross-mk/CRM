# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo servidor: crear usuarios, darlos de baja y cargar leads a mano. NUNCA exponer al navegador (no lleva NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública del sistema (para los enlaces de restablecer contraseña). Ej: https://TU-SITIO.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
